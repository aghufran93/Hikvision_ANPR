# ============================================================
# Hikvision ANPR Monitoring System - environment configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored - never commit real credentials.
# ============================================================

# ------------------------------------------------------------
# Camera connection (all four REQUIRED - anpr_common.py raises
# RuntimeError at startup if any are missing)
# ------------------------------------------------------------

# Entry camera IP or hostname. Read via camera_env_key="CAMERA_ENTRY"
# in entry_listener.py.
CAMERA_ENTRY=192.168.1.100

# Exit camera IP or hostname. Read via camera_env_key="CAMERA_EXIT"
# in exit_listener.py.
CAMERA_EXIT=192.168.1.101

# Digest-auth username, shared by both cameras.
CAMERA_USER=admin

# Digest-auth password, shared by both cameras.
CAMERA_PASS=change-me

# ------------------------------------------------------------
# Listener v2.0 event-cache tuning (all OPTIONAL - defaults shown)
# ------------------------------------------------------------

# Seconds with no new image for a given event before it is saved
# as-is (partial, if not all expected images have arrived yet).
ANPR_EVENT_IDLE_TIMEOUT=90

# Hard cap in seconds from an event's XML arrival to forced save,
# regardless of idle time.
ANPR_EVENT_MAX_LIFETIME=180

# After a partial save, how many extra seconds a late image is still
# accepted and attached to that event's existing JSON/images.
ANPR_LATE_ATTACH_WINDOW=60

# How long an image with no matching event is buffered before being
# written to xml_temp/<Camera>/orphans/ for manual review.
ANPR_ORPHAN_GRACE_SECONDS=5

# ------------------------------------------------------------
# Dashboard v2.0 live-update tuning (both OPTIONAL - defaults shown)
# ------------------------------------------------------------

# Client-side polling fallback interval in milliseconds, used
# alongside Server-Sent Events as a robustness safety net.
DASHBOARD_POLL_INTERVAL_MS=250

# How often (seconds) the dashboard's background thread re-scans
# output/Entry and output/Exit for new or changed files.
DASHBOARD_INDEX_SCAN_INTERVAL_S=0.3

# ------------------------------------------------------------
# NOT CURRENTLY READ BY ANY CODE
#
# The keys below have been seen in deployed .env files but do not
# appear anywhere in anpr_common.py or dashboard.py - setting them
# has NO EFFECT today. Listed here only so you don't waste time
# assuming they're wired up (in particular, APP_PORT does NOT
# change the dashboard's port - that's hardcoded to 5020 in
# dashboard.py's app.run() call). Left as a known gap - see the
# Code Review section shared alongside this file.
# ------------------------------------------------------------

# ENTRY_CAMERA_IP=
# EXIT_CAMERA_IP=
# ENTRY_OUTPUT=
# EXIT_OUTPUT=
# OG_DIR=
# XML_TEMP_DIR=
# CAMERA_PROTOCOL=
# APP_HOST=
